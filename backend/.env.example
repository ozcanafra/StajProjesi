# Postgres baglanti string'i. docker-compose ile calisirken host "db" olmali.
DATABASE_URL=postgresql+psycopg2://sentrascan:sentrascan@db:5432/sentrascan

# Celery/Redis. docker-compose ile calisirken host "redis" olmali.
REDIS_URL=redis://redis:6379/0

# JWT icin rastgele, uzun bir deger uretin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Frontend'in calistigi origin(ler), JSON liste formatinda.
CORS_ORIGINS=["http://localhost:5173"]

# AI rapor/chat katmani icin. Bos birakilirsa sistem, AI'siz bir fallback rapor uretir.
ANTHROPIC_API_KEY=
# Kullanmak istediginiz Claude model ID'si (bkz. https://docs.anthropic.com/en/docs/about-claude/models)
ANTHROPIC_MODEL=
