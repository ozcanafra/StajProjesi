# Postgres baglanti string'i. docker-compose ile calisirken host "db" olmali.
DATABASE_URL=postgresql+psycopg2://sentrascan:sentrascan@db:5432/sentrascan

# Celery/Redis. docker-compose ile calisirken host "redis" olmali.
REDIS_URL=redis://redis:6379/0

# JWT icin rastgele, uzun bir deger uretin: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Frontend'in calistigi origin(ler), JSON liste formatinda.
CORS_ORIGINS=["http://localhost:5173"]

# AI rapor/chat katmani yerel Ollama sunucusu uzerinden calisir: API anahtari
# gerekmez, ucretsizdir ve tarama bulgulari makineden disari cikmaz.
# Ollama'ya ulasilamazsa sistem kural tabanli bir fallback rapor uretir.
#
# docker-compose ile calisirken host "ollama" olmali. Ollama'yi kendi
# makinenize kurup kullanacaksaniz: http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
# Modeli bir kez indirmeniz gerekir:
#   docker compose exec ollama ollama pull qwen2.5:3b
# Daha guclu ama daha yavas alternatifler: qwen2.5:7b, llama3.1:8b
# Daha hizli ama daha zayif: qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:3b
# Yerel CPU cikariminda rapor uretimi uzun surebilir (saniye).
OLLAMA_TIMEOUT=300

# SADECE YEREL DEMO ICIN: true yaparsan DNS TXT sahiplik dogrulamasi
# gercekten kontrol edilmez, "Dogrulamayi kontrol et" butonuna basmak
# yeterli olur. Boylece gercek bir domain'in olmadan tarama akisini
# deneyebilirsin. PRODUCTION'DA VEYA BASKALARIYLA PAYLASILAN BIR
# ORTAMDA ASLA true YAPMA - herkes sahip olmadigi domainleri "dogrulayip"
# tarayabilir hale gelir.
SKIP_TARGET_VERIFICATION=false
